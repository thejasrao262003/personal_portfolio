# ── Database ─────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
# Example: mongodb+srv://user:pass@cluster0.xxx.mongodb.net/portfolio
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster0.xxxxx.mongodb.net/portfolio

# ── Site URL ──────────────────────────────────────────────
# Used for og:image absolute URLs and canonical links
NEXT_PUBLIC_SITE_URL=https://thejas-rao.dev

# ── Email Notifications (optional) ───────────────────────
# For contact form → email alerts (uses nodemailer)
# You can use Gmail app passwords: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=thejasrao262003@gmail.com

# ── Admin Auth (optional — for managing projects in prod) ─
# A simple secret token checked in admin API routes
ADMIN_SECRET=change_this_to_a_long_random_string
